# Meta WhatsApp Business Cloud API (server-side only; do not use VITE_ prefixes)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_DISPLAY_PHONE_NUMBER=+8801890047742

# Separate administrator account for /admin/whatsapp (password must be at least 16 characters)
WHATSAPP_ADMIN_USERNAME=
WHATSAPP_ADMIN_PASSWORD=

# Optional Calling API. Keep false until Calling is enabled for this number in Meta.
WHATSAPP_CALLING_ENABLED=false
# Optional public STUN URLs for browser WebRTC (STUN only; no credentials/secrets are sent to the browser).
# Example: stun:stun.example.net:3478,stuns:stun.example.net:5349
WHATSAPP_CALLING_STUN_URLS=

# Optional persistent storage path. On a mounted Render disk use /var/data/whatsapp-inbox.json.
# WHATSAPP_DATA_PATH=/var/data/whatsapp-inbox.json
